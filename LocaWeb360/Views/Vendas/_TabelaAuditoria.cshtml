@model IEnumerable<LocaSmart360.Models.Venda>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light text-secondary small fw-bold">
            <tr>
                <th class="ps-4 py-3">DATA</th>
                <th class="py-3">ID COMPRADOR</th>
                <th class="py-3">PRODUTO</th>
                <th class="py-3 text-center">SCORE</th>
                <th class="py-3 text-center">RISCO</th>
                <th class="py-3">JUSTIFICATIVA IA</th>
                <th class="pe-4 py-3 text-end">STATUS / AÇÃO</th>
            </tr>
        </thead>
        <tbody class="border-top-0 small">
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="bi bi-shield-slash fs-3 d-block mb-2"></i>
                        Nenhuma transação nesta categoria.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var venda in Model)
                {
                    string alertColor = venda.ScoreRiscoFraude > 60 ? "text-danger" : (venda.ScoreRiscoFraude > 25 ? "text-warning" : "text-success");
                    string bgProgressBar = venda.ScoreRiscoFraude > 60 ? "bg-danger" : (venda.ScoreRiscoFraude > 25 ? "bg-warning" : "bg-success");
                    string textoRisco = venda.ScoreRiscoFraude > 60 ? "Risco Crítico" : (venda.ScoreRiscoFraude > 25 ? "Risco Moderado" : "Baixo Risco");
                    string badgeAcao = venda.ScoreRiscoFraude > 60 ? "badge bg-danger bg-opacity-10 text-danger border border-danger" : (venda.ScoreRiscoFraude > 25 ? "badge bg-warning bg-opacity-10 text-dark border border-warning" : "badge bg-success bg-opacity-10 text-success border border-success");
                    string acaoNome = venda.ScoreRiscoFraude > 60 ? "Negada Automat." : (venda.ScoreRiscoFraude > 25 ? "Aguardando ID" : "Liberada");

                    <tr>
                        <td class="ps-4 text-muted">@venda.DataVenda.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="fw-bold text-secondary">#@venda.ClienteId</td>
                        <td>
                            <span class="d-block fw-bold text-dark">@(venda.Produto?.Nome ?? "Produto")</span>
                            <span class="text-muted xsmall">@venda.ValorTotal.ToString("C")</span>
                        </td>
                        <td class="text-center fw-bold @alertColor">@venda.ScoreRiscoFraude%</td>
                        <td>
                            <div class="progress" style="height: 6px; width: 100px;">
                                <div class="progress-bar @bgProgressBar" style="width: @venda.ScoreRiscoFraude%"></div>
                            </div>
                            <span class="xsmall fw-semibold @alertColor">@textoRisco</span>
                        </td>
                        <td class="text-muted" style="max-width: 200px;">
                            <span class="text-truncate d-block" title="@venda.JustificativaRisco">@venda.JustificativaRisco</span>
                        </td>
                        <td class="pe-4 text-end">
                            <span class="@badgeAcao px-3 py-2 fw-bold d-block mb-1">@acaoNome</span>

                            <!-- Botão que abre o Modal de Diagnóstico -->
                            <button type="button"
                                    class="btn btn-sm btn-outline-dark border-0"
                                    onclick="abrirDetalhes('@venda.VendaId')">
                                <i class="bi bi-search"></i> Diagnosticar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>