@model IEnumerable<LocaSmart360.Models.Venda>

@{
    ViewData["Title"] = "Central de Auditoria Anti-Fraude";
    Layout = "_Layout";

    // Filtros de contagem para os cards
    var normais = Model?.Where(v => v.ScoreRiscoFraude <= 25).ToList() ?? new List<LocaSmart360.Models.Venda>();
    var suspeitas = Model?.Where(v => v.ScoreRiscoFraude > 25 && v.ScoreRiscoFraude <= 60).ToList() ?? new List<LocaSmart360.Models.Venda>();
    var bloqueadas = Model?.Where(v => v.ScoreRiscoFraude > 60).ToList() ?? new List<LocaSmart360.Models.Venda>();
    var totalCount = Model?.Count() ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-uppercase text-primary fw-bold small">Motor de Inferência Ativo</span>
            <h2 class="fw-bold text-dark m-0">Central de Auditoria de Risco</h2>
            <p class="text-muted small mb-0">Triagem de comportamento transacional em tempo real baseado em regras heurísticas.</p>
        </div>
        <!-- Botão acionador do Modal -->
        <button type="button" class="btn btn-primary fw-bold px-4 py-2 shadow-sm" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#modalNovaSimulacao">
            <i class="bi bi-plus-lg me-2"></i> Nova Simulação / Ingestão
        </button>
    </div>

    <!-- CARDS DE SEGMENTAÇÃO -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-success shadow-sm p-3" style="border-radius: 8px;">
                <div class="card-body p-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-success fw-bold text-uppercase small mb-1">Aprovadas</h6>
                        <h3 class="fw-bold mb-0 text-dark">@normais.Count</h3>
                    </div>
                    <i class="bi bi-shield-check text-success fs-1"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-warning shadow-sm p-3" style="border-radius: 8px;">
                <div class="card-body p-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-warning fw-bold text-uppercase small mb-1">Suspeitas</h6>
                        <h3 class="fw-bold mb-0 text-dark">@suspeitas.Count</h3>
                    </div>
                    <i class="bi bi-shield-exclamation text-warning fs-1"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-danger shadow-sm p-3" style="border-radius: 8px;">
                <div class="card-body p-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-danger fw-bold text-uppercase small mb-1">Bloqueadas</h6>
                        <h3 class="fw-bold mb-0 text-dark">@bloqueadas.Count</h3>
                    </div>
                    <i class="bi bi-shield-slash text-danger fs-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- PAINEL DE TABELAS -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <ul class="nav nav-pills card-header-pills" id="pills-tab" role="tablist">
                <li class="nav-item"><button class="nav-link active px-4 fw-bold small text-uppercase me-2" data-bs-toggle="pill" data-bs-target="#pills-todas" type="button">Todas (@totalCount)</button></li>
                <li class="nav-item"><button class="nav-link px-4 fw-bold small text-uppercase me-2" data-bs-toggle="pill" data-bs-target="#pills-normais" type="button">Normais (@normais.Count)</button></li>
                <li class="nav-item"><button class="nav-link px-4 fw-bold small text-uppercase me-2" data-bs-toggle="pill" data-bs-target="#pills-suspeitas" type="button">Suspeitas (@suspeitas.Count)</button></li>
                <li class="nav-item"><button class="nav-link px-4 fw-bold small text-uppercase" data-bs-toggle="pill" data-bs-target="#pills-bloqueadas" type="button">Bloqueadas (@bloqueadas.Count)</button></li>
            </ul>
        </div>

        <div class="card-body p-0">
            <div class="tab-content p-4">
                <div class="tab-pane fade show active" id="pills-todas">@Html.Partial("_TabelaAuditoria", Model)</div>
                <div class="tab-pane fade" id="pills-normais">@Html.Partial("_TabelaAuditoria", normais)</div>
                <div class="tab-pane fade" id="pills-suspeitas">@Html.Partial("_TabelaAuditoria", suspeitas)</div>
                <div class="tab-pane fade" id="pills-bloqueadas">@Html.Partial("_TabelaAuditoria", bloqueadas)</div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE DIAGNÓSTICO -->
<div class="modal fade" id="modalDetalhes" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 15px;">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-shield-check me-2"></i>Diagnóstico Transacional</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3">
                    <div class="col-6"><small class="text-muted">ID Transação</small><h6 id="vendaId" class="text-truncate">-</h6></div>
                    <div class="col-6"><small class="text-muted">Data/Hora</small><h6 id="vendaData">-</h6></div>
                </div>
                <div class="mb-3"><small class="text-muted">Cliente / Produto</small><h6 id="vendaProduto">-</h6></div>
                <div class="mb-3"><small class="text-muted">Valor</small><h5 id="vendaValor" class="text-success fw-bold">-</h5></div>
                <div class="p-3 bg-light rounded border-start border-primary border-4">
                    <small class="text-muted">Score de Risco: <span id="vendaScore" class="fw-bold text-dark"></span></small>
                    <p class="mb-0 mt-1 fst-italic" id="vendaJustificativa" style="line-height: 1.4; color: #333;"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE NOVA SIMULAÇÃO -->
<div class="modal fade" id="modalNovaSimulacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-shield-plus me-2"></i>Nova Simulação de Transação</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <form asp-controller="Vendas" asp-action="Criar" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">ID do Cliente / Comprador</label>
                        <input type="text" name="ClienteId" class="form-control" placeholder="Ex: CLI-8842" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Produto ID (Se aplicável)</label>
                        <input type="text" name="ProdutoId" class="form-control" placeholder="Deixe em branco se for transação avulsa" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Valor Total da Transação (R$)</label>
                        <input type="number" step="0.01" name="ValorTotal" class="form-control" placeholder="0,00" required />
                    </div>

                    <div class="alert alert-light border small text-muted mb-0">
                        <i class="bi bi-info-circle me-1"></i> O motor heurístico calculará automaticamente o <strong>Score de Risco</strong> com base no comportamento.
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3" style="border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Executar Simulação</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirDetalhes(id) {
            fetch(`/Vendas/ObterDetalhes/${id}`)
                .then(response => {
                    if (!response.ok) throw new Error("Erro na requisição dos detalhes.");
                    return response.json();
                })
                .then(data => {
                    document.getElementById('vendaId').innerText = data.vendaId || data.id || '-';
                    document.getElementById('vendaData').innerText = data.dataVenda ? new Date(data.dataVenda).toLocaleString('pt-BR') : '-';
                    document.getElementById('vendaProduto').innerText = `Cliente: ${data.clienteId || 'N/D'} | Produto: ${data.produtoId || 'Avulso'}`;
                    document.getElementById('vendaValor').innerText = data.valorTotal ? `R$ ${data.valorTotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}` : 'R$ 0,00';
                    document.getElementById('vendaScore').innerText = data.scoreRiscoFraude ?? '0';
                    document.getElementById('vendaJustificativa').innerText = data.justificativaRisco || 'Nenhuma regra de risco ativada para esta transação.';

                    var modal = new bootstrap.Modal(document.getElementById('modalDetalhes'));
                    modal.show();
                })
                .catch(error => {
                    console.error("Erro:", error);
                    alert("Não foi possível carregar os detalhes do diagnóstico.");
                });
        }
    </script>
}