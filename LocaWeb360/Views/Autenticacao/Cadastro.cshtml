@model LocaSmart360.Models.Usuario

@{
    Layout = "_Layout";
    ViewData["Title"] = "Criar Conta - LocaSmart 360";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh; margin-top: 30px; margin-bottom: 30px;">
    <div class="card shadow-lg p-4 bg-white" style="width: 100%; max-width: 500px; border-radius: 12px; border-top: 5px solid var(--ls-success);">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-success">Criar Conta</h2>
            <p class="text-muted small">Insira os dados da sua loja para liberação das APIs</p>
        </div>

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger small py-2 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Erro
            </div>
        }

        <div class="bg-light p-2 border rounded mb-3 small text-muted">
            <span class="fw-bold d-block mb-1"><i class="bi bi-shield-lock-fill text-success me-1"></i> A senha deve conter:</span>
            <ul class="mb-0 ps-3" style="font-size: 0.85rem;">
                <li>No mínimo 8 caracteres</li>
                <li>Pelo menos uma letra <strong>MAIÚSCULA</strong></li>
                <li>Pelo menos uma letra <strong>minúscula</strong></li>
                <li>Pelo menos um <strong>caractere especial</strong> (Ex: @@, #, $, %, &amp;)</li>
            </ul>
        </div>

        <form asp-controller="Autenticacao" asp-action="Cadastro" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label small fw-semibold text-secondary">Seu Nome Completo</label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" required autofocus />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label small fw-semibold text-secondary">E-mail Corporativo</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="nome@provedor.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NomeLoja" class="form-label small fw-semibold text-secondary">Nome da sua Loja (Mercado Livre)</label>
                <input asp-for="NomeLoja" class="form-control" placeholder="Ex: TechStore Eletrônicos" required />
                <span asp-validation-for="NomeLoja" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cargo" class="form-label small fw-semibold text-secondary">Nível de Acesso (Cargo)</label>
                <select asp-for="Cargo" class="form-control">
                    <option value="Administrador">Administrador (Acesso Total)</option>
                    <option value="Lojista" selected>Lojista</option>
                </select>
                <span asp-validation-for="Cargo" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label for="senha" class="form-label small fw-semibold text-secondary">Crie uma Senha</label>
                <input type="password" id="senha" name="senha" class="form-control" placeholder="Digite sua senha forte" required />
            </div>

            <div class="form-group mb-4">
                <label for="confirmarSenha" class="form-label small fw-semibold text-secondary">Repita a Senha</label>
                <input type="password" id="confirmarSenha" name="confirmarSenha" class="form-control" placeholder="Confirme exatamente a mesma senha" required />
            </div>

            <div class="d-grid gap-2 mb-3">
                <button type="submit" class="btn btn-success btn-lg fw-semibold shadow-sm" style="border-radius: 8px;">
                    <i class="bi bi-person-plus-fill me-1"></i> Finalizar Cadastro
                </button>
            </div>
        </form>

        <hr class="text-muted my-3">

        <div class="text-center">
            <p class="text-muted small mb-0">
                Já possui uma conta ativa?
                <a asp-controller="Autenticacao" asp-action="Login" class="text-decoration-none fw-bold text-success">
                    Faça Login aqui
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}