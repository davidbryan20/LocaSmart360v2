                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 border rounded-3 bg-light">
                    <i class="bi bi-shield-lock-fill fs-3 text-primary mb-2 d-block"></i>
                    <strong class="text-dark d-block">Heurística &amp; ETL</strong>
                    <span class="text-muted small">Motor de Risco &amp; Pipelines</span>
                </div>
            </div>
        </div>
    </div>

