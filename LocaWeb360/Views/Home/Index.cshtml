@{
    ViewData["Title"] = "Prevenção Inteligente a Fraudes";
}

<div class="py-2">
    <!-- Hero Section Executiva Corporativa -->
    <div class="card border-0 text-white rounded-4 p-5 mb-5 shadow-sm position-relative overflow-hidden bg-loca-dark border border-secondary border-opacity-25">
        <!-- Elemento Gráfico de Fundo Sutil (Escudo reposicionado para não conflitar) -->
        <div class="position-absolute top-50 end-0 translate-middle-y pe-4 opacity-10 d-none d-lg-block pointer-events-none" style="z-index: 0;">
            <i class="bi bi-shield-lock-fill" style="font-size: 16rem; line-height: 0;"></i>
        </div>

        <div class="row align-items-center py-3 position-relative z-1">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center bg-primary bg-opacity-20 text-primary rounded-pill px-3 py-1 mb-4 small fw-bold tracking-wider border border-primary border-opacity-25">
                    <i class="bi bi-shield-check me-2"></i> LOCASMART 360 • PLATAFORMA DE GOVERNANÇA &amp; RISCO
                </div>
                <h1 class="display-5 fw-bold mb-3 tracking-tight">Mitigação Avançada de Fraudes &amp; <span class="text-primary">Data Intelligence</span></h1>
                <p class="lead text-light text-opacity-75 mb-4 fs-6" style="line-height: 1.6;">
                    Ecossistema integrado de alta performance para auditoria transacional em tempo real. Proteja operações de e-commerce combinando motores heurísticos comportamentais e pipelines de ingestão de dados em larga escala.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Vendas" asp-action="Index" class="btn btn-primary btn-lg fw-bold px-4 py-3 shadow-sm d-inline-flex align-items-center" style="border-radius: 8px;">
                        <i class="bi bi-speedometer2 me-2"></i> Acessar Central de Vendas
                    </a>
                    <a asp-controller="Vendas" asp-action="Integracao" class="btn btn-outline-light btn-lg fw-bold px-4 py-3 d-inline-flex align-items-center" style="border-radius: 8px;">
                        <i class="bi bi-cpu me-2"></i> Configurar Sandbox ETL
                    </a>
                </div>
            </div>

            <!-- Painel Lateral de Telemetria dimensionado corretamente -->
            <div class="col-lg-5 d-none d-lg-block ps-lg-4">
                <div class="p-4 bg-loca-card rounded-4 border border-secondary border-opacity-50 shadow-lg text-start mx-auto" style="max-width: 420px;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary text-white rounded-3 p-2 me-3 shadow-sm"><i class="bi bi-activity fs-5"></i></div>
                            <div>
                                <h6 class="mb-0 text-white fw-bold small text-uppercase tracking-wider">Telemetria de Motor</h6>
                                <span class="text-success small fw-semibold"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Latência Média &lt; 38ms</span>
                            </div>
                        </div>
                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-2 py-1">Estável</span>
                    </div>

                    <hr class="border-secondary opacity-25 my-3">

                    <div class="row text-center mt-3 g-2">
                        <div class="col-6 border-end border-secondary border-opacity-25">
                            <span class="text-muted small d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Precisão Heurística</span>
                            <strong class="text-white fs-4 fw-bold">99.7%</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block text-uppercase fw-semibold" style="font-size: 0.7rem;">Pipeline Status</span>
                            <strong class="text-success fs-4 fw-bold">Sincronizado</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicadores de Pilares Tecnológicos -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 border-top border-4 border-primary bg-loca-card">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-bold tracking-wider" style="font-size: 0.75rem;">Arquitetura de Dados</span>
                        <h5 class="fw-bold text-white mb-0">Pipeline de Ingestão (ETL)</h5>
                    </div>
                </div>
                <p class="text-muted small mb-0" style="line-height: 1.5;">
                    Processamento massivo e estruturado de lotes transacionais em formato JSON. Higienização de anomalias e persistência automatizada no Data Lake corporativo.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 border-top border-4 border-dark bg-loca-card">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-dark text-white rounded-3 p-3 me-3 border border-secondary border-opacity-50">
                        <i class="bi bi-shield-shaded fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-bold tracking-wider" style="font-size: 0.75rem;">Inteligência Preditiva</span>
                        <h5 class="fw-bold text-white mb-0">Análise Heurística de Risco</h5>
                    </div>
                </div>
                <p class="text-muted small mb-0" style="line-height: 1.5;">
                    Avaliação comportamental dinâmica cruzando desvios de ticket médio histórico, geolocalização e padrões atípicos de compras em horários críticos.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 border-top border-4 border-success bg-loca-card">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="bi bi-cloud-check-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase fw-bold tracking-wider" style="font-size: 0.75rem;">Repositório Analítico</span>
                        <h5 class="fw-bold text-white mb-0">Supabase Cloud DB</h5>
                    </div>
                </div>
                <p class="text-muted small mb-0" style="line-height: 1.5;">
                    Isolamento seguro entre tabelas de dados brutos e camadas analíticas de alta velocidade para emissão instantânea de relatórios de conformidade.
                </p>
            </div>
        </div>
    </div>

    <!-- Barra de Atalho Institucional para Auditoria e LGPD -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 border-start border-4 border-primary bg-loca-card">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white rounded-3 p-3 me-3 shadow-sm d-none d-sm-block">
                        <i class="bi bi-file-earmark-lock2 fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-white mb-1">Central de Auditoria Transacional &amp; LGPD</h5>
                        <p class="text-muted small mb-0">Consulte logs de triagem detalhados, revise decisões do motor automatizado e assegure conformidade regulatória rigorosa.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a asp-controller="Vendas" asp-action="Auditoria" class="btn btn-outline-light fw-bold px-4 py-2 shadow-sm rounded-3 d-inline-flex align-items-center">
                    <i class="bi bi-shield-exclamation me-2 text-primary"></i> Abrir Central de Risco
                </a>
            </div>
        </div>
    </div>
</div>